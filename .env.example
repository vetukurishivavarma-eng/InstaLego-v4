# One free-tier key per provider. Leave a key blank to skip that provider in the fallback chain.
GROQ_API_KEY=            # https://console.groq.com/keys
CEREBRAS_API_KEY=        # https://cloud.cerebras.ai
GEMINI_API_KEY=          # https://aistudio.google.com/apikey
MISTRAL_API_KEY=         # https://console.mistral.ai/api-keys
OPENROUTER_API_KEY=      # https://openrouter.ai/keys  (only :free models are used)

POSTGRES_DB=legalverify
POSTGRES_USER=legalverify
POSTGRES_PASSWORD=change-me

# Payment: "mock" unlocks instantly for testing; set razorpay test keys to use real checkout
PAYMENT_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
UNLOCK_PRICE_INR=499

# OCR: PaddleOCR script model (te, ta, kn, hi, mr, en ...). Indic models also read English.
OCR_LANG=te
